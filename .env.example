#copiar este archivo a .env y completar los valores reales
#el .env real no se sube a git

#url del backend (API REST). en produccion, la url publica de vercel
PUBLIC_API_URL=http://localhost:4000

#configuracion publica del proyecto de firebase (autenticacion de usuarios)
#se obtiene en la consola de firebase: configuracion del proyecto > tus apps > config del sdk
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=