---
//seccion de proyectos destacados: va antes de "sobre mi"
//es solo el marco y el titulo; el carrusel que gira solo vive en carruseldestacados.jsx
import CarruselDestacados from './CarruselDestacados.jsx';
---

<section id="destacados" class="py-16 px-4">
  <div class="max-w-5xl mx-auto space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="text-left space-y-2">
        <h2 class="text-3xl font-bold text-white inline-flex items-center gap-3">
          <svg
            aria-hidden="true"
            class="w-8 h-8 text-violeta-app"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              strokeLinecap="round"
              strokeLinejoin="round"
              d="m12 3 2.6 5.6 6.1.8-4.5 4.2 1.2 6-5.4-3-5.4 3 1.2-6L3.3 9.4l6.1-.8z"
            ></path>
          </svg>
          Proyectos destacados
        </h2>
        <p class="text-zinc-400">Los que más me gustan, se van pasando solos.</p>
      </div>
      <a
        href="/proyectos"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-violeta-app hover:bg-violeta-app/90 text-black text-sm font-medium transition-all duration-200 hover:scale-105 active:scale-95"
      >
        Ver todos
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <CarruselDestacados client:visible />
  </div>
</section>