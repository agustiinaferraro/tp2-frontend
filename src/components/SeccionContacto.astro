---
//seccion de contacto
//la parte estatica (titulo y redes) vive en este .astro
//el formulario en si es un componente react (client:load) con estados
import FormularioContacto from './FormularioContacto.jsx';

---

<section id="contacto" class="py-16 px-4">
  <div class="max-w-3xl mx-auto text-center space-y-8">
    <div class="space-y-6 text-left">
      <h2 class="text-4xl font-bold text-white inline-flex items-center gap-3">
        <svg
          aria-hidden="true"
          class="w-9 h-9 text-verde-app"
          fill="none"
          stroke="currentColor"
          strokeWidth="1.8"
          viewBox="0 0 24 24"
        >
          <path
            strokeLinecap="round"
            strokeLinejoin="round"
            d="M4 4h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"
          />
          <path strokeLinecap="round" strokeLinejoin="round" d="m22 6-10 7L2 6" />
        </svg>
        Contacto
      </h2>
      <p class="text-zinc-400 leading-relaxed">
        ¿Tenés un proyecto en mente? Escribime y te respondo a la brevedad.
      </p>
    </div>

    <FormularioContacto client:load />
  </div>
</section>