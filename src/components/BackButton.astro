---
//boton reutilizable para volver
//uso: <backbutton href="/" /> o sin href (en ese caso usa history.back)
//queda fijo abajo del nav en la misma esquina de todas las paginas para que no se mueva al scrollear
const { href = '' } = Astro.props;
---

{
  href ? (
    <a
      href={href}
      aria-label="Volver"
      title="Volver"
      class="fixed top-20 left-4 z-40 inline-flex items-center justify-center w-14 h-14 rounded-full bg-zinc-900/70 backdrop-blur-md border border-zinc-700 text-zinc-300 hover:text-white hover:border-zinc-500 transition-all duration-200 hover:scale-105 active:scale-95"
    >
      <svg
        aria-hidden="true"
        class="w-7 h-7"
        fill="none"
        stroke="currentColor"
        strokeWidth="2"
        viewBox="0 0 24 24"
      >
        <path strokeLinecap="round" strokeLinejoin="round" d="M15 18l-6-6 6-6" />
      </svg>
    </a>
  ) : (
    <button
      type="button"
      data-back-button
      aria-label="Volver"
      title="Volver"
      class="fixed top-20 left-4 z-40 inline-flex items-center justify-center w-14 h-14 rounded-full bg-zinc-900/70 backdrop-blur-md border border-zinc-700 text-zinc-300 hover:text-white hover:border-zinc-500 transition-all duration-200 hover:scale-105 active:scale-95"
    >
      <svg
        aria-hidden="true"
        class="w-7 h-7"
        fill="none"
        stroke="currentColor"
        strokeWidth="2"
        viewBox="0 0 24 24"
      >
        <path strokeLinecap="round" strokeLinejoin="round" d="M15 18l-6-6 6-6" />
      </svg>
    </button>
  )
}

<script>
  //si no se pasa href, vuelve una pagina atras con el historial del navegador
  const boton = document.querySelector('[data-back-button]');
  boton?.addEventListener('click', () => history.back());
</script>