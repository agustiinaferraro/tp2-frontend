---
//seccion de proyectos: marco y titulo (estaticos)
//la grilla con los datos dinamicos vive en grillaproyectos.jsx (isla de react)
//"vista" decide como se ven: carrusel (home) o grilla completa (pagina de proyectos)
//en la pagina de proyectos el titulo ya esta en la portada de arriba, por eso ahi no se muestra
import GrillaProyectos from './GrillaProyectos.jsx';
import SaludoPersonalizado from './SaludoPersonalizado.jsx';

const { vista = 'carrusel', mostrarTitulo = true } = Astro.props;
---

<section id="proyectos" class="py-16 px-4">
  <div class="max-w-5xl mx-auto space-y-6">
    {
      mostrarTitulo && (
        <div class="text-left space-y-4 encabezado-seccion-proyectos">
          <h2 class="text-4xl font-bold text-white inline-flex items-center gap-3">
            <svg
              aria-hidden="true"
              class="w-9 h-9 text-verde-app"
              fill="none"
              stroke="currentColor"
              strokeWidth="1.8"
              viewBox="0 0 24 24"
            >
              <path
                strokeLinecap="round"
                strokeLinejoin="round"
                d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
              />
            </svg>
            <SaludoPersonalizado
              client:load
              sinNombre="Podés observar mis trabajos"
              conNombre="Podés observar mis trabajos, {nombre}"
            />
          </h2>
          <p class="text-zinc-400">Marcas, motion y aplicaciones web</p>
        </div>
      )
    }
    <GrillaProyectos client:load vista={vista} />
  </div>
</section>
