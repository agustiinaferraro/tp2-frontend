---
//pagina "sobre mi": presenta el recorrido completo (linea de tiempo del cv)
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BackButton from '../components/BackButton.astro';
import RecorridoSobreMi from '../components/RecorridoSobreMi.astro';
---

<Layout title="Sobre mí | Agustina Ferraro">
  <Navbar seccionActiva="sobre-mi" />
  <main id="contenido" class="pt-16">
    <div class="max-w-6xl mx-auto px-4 pt-8">
      <BackButton href="/" />
    </div>
    <RecorridoSobreMi />
  </main>
  <Footer />
</Layout>