---
//pagina "sobre mi": presenta el recorrido completo (linea de tiempo del cv)
//el contenido viene del backend (GET /api/perfil) y se pide en el build.
//si la api no responde, se usa un respaldo local para no romper el sitio.
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BackButton from '../components/BackButton.astro';
import RecorridoSobreMi from '../components/RecorridoSobreMi.astro';
import { contenidoRespaldo } from '../data/contenido-respaldo.js';

//url base del backend (misma que usa el resto del front)
const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:4000';

//por defecto arranca con el respaldo; si la api responde, se reemplaza
let contenido = contenidoRespaldo;
try {
  const respuesta = await fetch(`${API_BASE}/api/perfil`);
  if (respuesta.ok) {
    const perfil = await respuesta.json();
    contenido = {
      estadisticas: perfil.estadisticas?.length ? perfil.estadisticas : contenidoRespaldo.estadisticas,
      recorrido: perfil.recorrido?.length ? perfil.recorrido : contenidoRespaldo.recorrido,
      habilidades: perfil.habilidades?.length ? perfil.habilidades : contenidoRespaldo.habilidades,
      certificaciones: perfil.certificaciones?.length
        ? perfil.certificaciones
        : contenidoRespaldo.certificaciones,
    };
  } else {
    console.warn(`No se pudo obtener el perfil (${respuesta.status}); se usa el respaldo local.`);
  }
} catch (error) {
  console.warn(`No se pudo conectar a la api; se usa el respaldo local. ${error.message}`);
}
---

<Layout title="Sobre mí | Agustina Ferraro">
  <Navbar seccionActiva="sobre-mi" />
  <main id="contenido" class="pt-16 relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0">
      <div class="absolute inset-0">
        <img
          src="/img/bg-sobre-mi.gif"
          alt=""
          class="w-full h-full object-cover object-center opacity-20"
        />
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/90"></div>
    </div>
    <div class="max-w-6xl mx-auto px-4 pt-8 relative z-10">
      <BackButton href="/" />
    </div>
    <RecorridoSobreMi {...contenido} />
  </main>
  <Footer />
</Layout>