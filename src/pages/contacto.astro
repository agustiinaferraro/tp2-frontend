---
//pagina "contacto": reusa la seccion del home (incluye el formulario)
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BackButton from '../components/BackButton.astro';
import SeccionContacto from '../components/SeccionContacto.astro';
---

<Layout title="Contacto | Agustina Ferraro">
  <Navbar seccionActiva="contacto" />
  <main id="contenido" class="pt-16">
    <div class="max-w-6xl mx-auto px-4 pt-8">
      <BackButton href="/" />
    </div>
    <SeccionContacto />
  </main>
  <Footer />
</Layout>