---
//pagina "admin": panel privado para cargar, editar y borrar proyectos
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BackButton from '../components/BackButton.astro';
import AdminProyectos from '../components/AdminProyectos.jsx';
---

<Layout title="Admin | Agustina Ferraro">
  <Navbar />
  <main id="contenido" class="pt-16">
    <div class="max-w-6xl mx-auto px-4 pt-8">
      <BackButton href="/" />
    </div>
    <AdminProyectos client:load />
  </main>
  <Footer />
</Layout>